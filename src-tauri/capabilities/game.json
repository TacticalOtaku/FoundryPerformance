{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "game-telemetry",
  "windows": [
    "game",
    "game-*"
  ],
  "remote": {
    "urls": [
      "https://*:*/*",
      "http://*:*/*"
    ]
  },
  "permissions": [
    "allow-report-telemetry",
    "allow-toggle-fullscreen"
  ]
}
